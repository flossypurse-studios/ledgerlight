{
  "name": "ledgerlight",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Checks that the tests a loss ledger cites actually ran in the run you are quoting. NO-REPORT is never a pass.",
  "keywords": [
    "loss-ledger",
    "testing",
    "test-coverage",
    "vitest",
    "playwright",
    "cli",
    "ci"
  ],
  "license": "MIT",
  "author": "FlossyPurse Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flossypurse-studios/ledgerlight.git"
  },
  "homepage": "https://github.com/flossypurse-studios/ledgerlight#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ledgerlight": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "bugs": {
    "url": "https://github.com/flossypurse-studios/ledgerlight/issues"
  }
}
